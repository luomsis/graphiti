# Graphiti Web Service — 基础镜像
# 预装全部 npm 依赖（含 devDependencies），供业务镜像构建时复用
#
# 构建示例:
#   docker build -f Dockerfile.base -t graphiti-web-base:node20 .
#
# 依赖不变时无需重建；代码修改后仅需重建业务镜像（秒级）
# 如需导出 amd64 镜像供生产部署，使用:
#   docker buildx build --platform linux/amd64 -f Dockerfile.base -t graphiti-web-base:node20 --load .

FROM node:20-alpine

WORKDIR /app

# 仅复制包清单，利用 Docker 层缓存
COPY package.json package-lock.json* ./

# 安装全部依赖（含 devDependencies，构建时需要 TypeScript/PostCSS 等）
RUN npm install --no-audit --no-fund

# OCI 标签
ARG BUILD_DATE
ARG VCS_REF
LABEL org.opencontainers.image.title="Graphiti Web Base (Node 20)" \
      org.opencontainers.image.description="Pre-installed npm dependencies for Graphiti web service" \
      org.opencontainers.image.vendor="Zep AI" \
      org.opencontainers.image.source="https://github.com/getzep/graphiti" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.revision="${VCS_REF}"
